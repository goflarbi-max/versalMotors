# Copy this file to .env for local configuration.
APP_ENV=development
VERSALMOTORS_DB_PATH=data/business.duckdb
GEMINI_API_KEY=replace_with_your_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_MAX_ATTEMPTS=2
VERSALMOTORS_AUTH_USERS_JSON=
VERSALMOTORS_SESSION_SECRET=replace_with_a_long_random_secret
VERSALMOTORS_SESSION_HOURS=8
VERSALMOTORS_ALLOWED_ORIGINS=http://localhost:3000,https://autobusiness.goflarbi.com
VERSALMOTORS_SECURE_COOKIES=true
